QAbstractSpinBox[mp_form_editor="true"] {
    background: $FORM_CARD_BG;
    color: $FORM_TEXT;
    border: 1px solid $FORM_BORDER_STRONG;
    border-radius: 10px;
    padding: 7px 12px;
    min-height: 16px;
    selection-background-color: $FORM_PRIMARY_SOFT;
    selection-color: $FORM_TEXT;
}

QAbstractSpinBox[mp_form_editor="true"]:focus {
    border: 1px solid $FORM_PRIMARY;
}

QAbstractSpinBox[mp_form_editor="true"]:hover {
    border-color: #94A3B8;
}

QAbstractSpinBox[mp_form_editor="true"]::up-button,
QAbstractSpinBox[mp_form_editor="true"]::down-button {
    width: 0;
    border: none;
    background: transparent;
}
