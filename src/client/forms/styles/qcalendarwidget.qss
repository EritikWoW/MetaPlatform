QCalendarWidget {
    background: $FORM_CARD_BG;
    border: 1px solid $FORM_BORDER_STRONG;
    border-radius: 10px;
    min-width: 280px;
    min-height: 280px;
}

QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: $FORM_CARD_BG;
    border-bottom: 1px solid $FORM_BORDER;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px 8px;
    min-height: 20;
}

#qt_calendar_prevmonth,
#qt_calendar_nextmonth {
    border: none;
    border-radius: 6px;
    background: transparent;
    qproperty-icon: none;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    font-size: 16px;
    font-weight: bold;
    color: $FORM_MUTED;
    padding: 0;
}

#qt_calendar_prevmonth {
    qproperty-text: "<";
}

#qt_calendar_nextmonth {
    qproperty-text: ">";
}

#qt_calendar_prevmonth:hover,
#qt_calendar_nextmonth:hover {
    background: $FORM_ACCENT_BG;
    color: $FORM_PRIMARY;
}

#qt_calendar_monthbutton,
#qt_calendar_yearbutton {
    color: $FORM_TEXT;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
    min-width: 70px;
    min-height: 28px;
    padding: 0 8px;
}

#qt_calendar_monthbutton:hover,
#qt_calendar_yearbutton:hover {
    background: $FORM_ACCENT_BG;
    color: $FORM_PRIMARY;
}

#qt_calendar_yearedit {
    color: $FORM_TEXT;
    background: transparent;
    border: none;
    font-weight: 600;
    min-width: 55px;
    max-width: 55px;
}

#qt_calendar_calendarview {
    background: $FORM_CARD_BG;
    color: $FORM_TEXT;
    selection-background-color: $FORM_PRIMARY;
    selection-color: #FFFFFF;
    alternate-background-color: $FORM_CARD_BG;
    border: none;
    outline: none;
    gridline-color: $FORM_BORDER;
}

QCalendarWidget QAbstractItemView:disabled {
    color: $FORM_MUTED;
}
